#ifndef KOLIOP_INTERNAL_BUILDSPECIFICITIES_H
#define KOLIOP_INTERNAL_BUILDSPECIFICITIES_H

#define KOLIOP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define KOLIOP_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define KOLIOP_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define KOLIOP_VERSION_TWEAK @PROJECT_VERSION_TWEAK@
#define KOLIOP_VERSION       "@PROJECT_VERSION@"

////////////////////////////////////////
/// KOLIOP_ASSERT_ENABLED
///
/// If not defined, disable assertion, else, enable them.
///
/// Example usage:
///
///     #if defined(KOLIOP_ASSERT_ENABLED)
///         KOLIOP_ASSERT(x > 10);
///     #else
///         something else;
///     #endif
///
////////////////////////////////////////

#cmakedefine KOLIOP_ASSERT_ENABLED

#endif
